# Copy to .env and fill in.  deploy/setup.sh writes a production .env for you automatically.
# On your laptop, a .env containing just  DJANGO_DEBUG=true  is enough to start developing.

# --- Core (production is the default: DEBUG off, a secret key is REQUIRED) ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=paalvi.in,www.paalvi.in
CSRF_TRUSTED_ORIGINS=https://paalvi.in,https://www.paalvi.in
CORS_ALLOWED_ORIGINS=https://paalvi.in,https://www.paalvi.in
SITE_URL=https://paalvi.in
# Where uploaded photos are reachable (same as SITE_URL unless media is on another domain / CDN)
# MEDIA_BASE_URL=https://paalvi.in
# Move the admin away from /admin/ to cut automated attacks (keep the trailing slash)
ADMIN_URL=studio-admin-7x2/
# Header holding the real visitor IP, set by YOUR proxy:
#   HTTP_X_REAL_IP (nginx/Caddy — default) · HTTP_CF_CONNECTING_IP (Cloudflare) · XFF_RIGHTMOST (Heroku/AWS ALB) · REMOTE_ADDR (no proxy)
CLIENT_IP_HEADER=HTTP_X_REAL_IP
# HSTS extras — only turn on once EVERY subdomain uses HTTPS
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true

# --- Database (empty = SQLite file, fine for a demo; use PostgreSQL in production) ---
# DATABASE_URL=postgres://paalvi:password@127.0.0.1:5432/paalvi

# --- Cache, rate limits & login lockout (Redis recommended; empty = file cache) ---
# REDIS_URL=redis://127.0.0.1:6379/1
RATE_LIMIT_AI_PER_MIN=15
RATE_LIMIT_INQUIRY_PER_MIN=12
RATE_LIMIT_CATALOG_PER_MIN=180
RATE_LIMIT_LOGIN_PER_MIN=10
AXES_FAILURE_LIMIT=5

# --- Media on Cloudflare R2 / AWS S3 (optional; needed on hosts without a permanent disk) ---
USE_S3_MEDIA=false
# S3_BUCKET_NAME=paalvi-media
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com     (AWS S3: leave empty)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_CUSTOM_DOMAIN=media.paalvi.in
# 3D model upload limit (MB)
MAX_3D_MODEL_MB=20
# Private files (expense receipts) — never publicly served
# PRIVATE_MEDIA_ROOT=/srv/paalvi/private_media

# --- AI Care Guide (any OpenAI-compatible provider) ---
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_SECONDS=12

# --- Emails: new-lead alerts and server-error alerts (optional) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# LEAD_NOTIFY_EMAILS=owner@paalvi.in
# ERROR_EMAILS=owner@paalvi.in

# --- Error tracking (optional, free tier at sentry.io) ---
# SENTRY_DSN=

# --- Analytics retention ---
TRAFFIC_RETENTION_DAYS=180
