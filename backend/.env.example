# Copy to .env and fill in. Everything has a safe local default.

# --- Core ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,paalvi.in,www.paalvi.in,api.paalvi.in
CSRF_TRUSTED_ORIGINS=https://paalvi.in,https://www.paalvi.in,https://api.paalvi.in
SITE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=https://paalvi.in,https://www.paalvi.in

# --- Database (leave empty for SQLite) ---
# DATABASE_URL=postgres://paalvi:password@localhost:5432/paalvi

# --- Cache / rate limits (leave empty to use a file cache in backend/.cache) ---
# REDIS_URL=redis://localhost:6379/1
RATE_LIMIT_AI_PER_MIN=15
RATE_LIMIT_INQUIRY_PER_MIN=5

# --- Media on Cloudflare R2 (optional) ---
USE_S3_MEDIA=false
# S3_BUCKET_NAME=paalvi-media
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_CUSTOM_DOMAIN=media.paalvi.in

# --- AI Care Guide (any OpenAI-compatible provider) ---
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
# Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-2.0-flash
# Ollama: AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.1

# --- New-lead email alerts (optional) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# LEAD_NOTIFY_EMAILS=owner@paalvi.in
